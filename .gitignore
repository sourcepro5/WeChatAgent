/apps/bridge/roles/
/components/qq-bridge/config.json
/components/qq-bridge/config.json.*
/components/qq-bridge/config.social.json
/components/qq-bridge/config.social.json.*
/components/qq-bridge/state/

# 已授权人格作为公开预设保留
