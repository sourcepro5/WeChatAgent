{
  "id": "speech-recognition",
  "name": "语音识别 API",
  "version": "1.5.0",
  "apiVersion": 2,
  "host": "wechatagent",
  "author": "WeChatAgent",
  "description": "按公共协议连接语音服务：填写服务地址、密钥和模型 ID，无需逐个适配模型。支持文件转写、Chat 音频及已有自定义请求。",
  "permissions": [
    "audio_read"
  ],
  "requiresHostFeatures": [
    "actions-v1",
    "voice-input-v1"
  ],
  "requiresAccount": true,
  "settings": {
    "apiProtocol": "auto",
    "endpoint": "",
    "apiKey": "",
    "authHeader": "Authorization",
    "authPrefix": "Bearer ",
    "headersJson": "{}",
    "requestMode": "multipart",
    "model": "",
    "language": "",
    "audioFormat": "wav",
    "fileField": "file",
    "modelField": "model",
    "languageField": "language",
    "extraFieldsJson": "{}",
    "jsonTemplate": "{\"audio\":\"{{audio_base64}}\",\"model\":\"{{model}}\"}",
    "responseMode": "json",
    "responsePath": "text",
    "timeoutMs": 20000,
    "maxDurationSeconds": 60,
    "maxTranscriptChars": 4000,
    "cacheResults": true,
    "modelsEndpoint": "",
    "modelsResponsePath": "data",
    "autoReadModels": true
  },
  "configSchema": {
    "apiProtocol": {
      "type": "string",
      "title": "API 协议（通常保留 auto）",
      "description": "auto 根据地址识别：基础地址默认文件转写，/chat/completions 使用 Chat 音频。也可按平台文档明确选协议；模型名不参与判断，旧自定义请求保留。",
      "enum": [
        "auto",
        "openai-transcriptions",
        "openai-chat",
        "chat-audio-data-url",
        "anthropic-messages",
        "custom"
      ]
    },
    "endpoint": {
      "type": "string",
      "title": "服务地址",
      "description": "粘贴平台的 API 基础地址（通常含 /v1）或完整 /audio/transcriptions、/chat/completions 地址。保留网关前缀，不自动补 /v1。",
      "maxLength": 2048
    },
    "apiKey": {
      "type": "string",
      "title": "API 密钥",
      "description": "仅粘贴原始 Key，不带 Bearer、引号或 API_KEY=；无需密钥的本机服务可留空。",
      "secret": true,
      "maxLength": 4096
    },
    "authHeader": {
      "type": "string",
      "title": "密钥请求头名称",
      "maxLength": 100
    },
    "authPrefix": {
      "type": "string",
      "title": "密钥前缀（保留末尾空格）",
      "maxLength": 100
    },
    "headersJson": {
      "type": "string",
      "title": "额外请求头（JSON）",
      "description": "可填写自定义鉴权头；界面隐藏已保存值。",
      "secret": true,
      "maxLength": 16000
    },
    "requestMode": {
      "type": "string",
      "title": "请求格式",
      "enum": [
        "multipart",
        "json"
      ]
    },
    "model": {
      "type": "string",
      "title": "识别模型",
      "description": "从模型列表选择，或原样粘贴平台提供的模型 ID / 别名。无需在插件登记模型；请用内置短句确认它支持所选音频协议。",
      "maxLength": 200
    },
    "language": {
      "type": "string",
      "title": "语言参数（可留空）",
      "maxLength": 40
    },
    "audioFormat": {
      "type": "string",
      "title": "上传音频格式",
      "description": "新版宿主内置 SILK 转 WAV 组件，无需安装 Python 依赖或识别模型；silk 则直接上传原始音频。",
      "enum": [
        "wav",
        "silk"
      ]
    },
    "fileField": {
      "type": "string",
      "title": "multipart 音频字段名",
      "minLength": 1,
      "maxLength": 100
    },
    "modelField": {
      "type": "string",
      "title": "multipart 模型字段名",
      "maxLength": 100
    },
    "languageField": {
      "type": "string",
      "title": "multipart 语言字段名",
      "maxLength": 100
    },
    "extraFieldsJson": {
      "type": "string",
      "title": "额外请求参数（JSON 对象，通常不用改）",
      "maxLength": 16000
    },
    "jsonTemplate": {
      "type": "string",
      "title": "JSON 请求模板",
      "description": "支持 {{audio_base64}}、{{audio_data_url}}、{{model}}、{{language}}、{{filename}}、{{mime_type}}、{{sample_rate}}、{{audio_bytes}}。",
      "maxLength": 32000
    },
    "responseMode": {
      "type": "string",
      "title": "响应格式",
      "enum": [
        "json",
        "text"
      ]
    },
    "responsePath": {
      "type": "string",
      "title": "JSON 转写结果路径",
      "description": "例如 text、data.text、results.0.text；留空表示根值。",
      "maxLength": 300
    },
    "timeoutMs": {
      "type": "integer",
      "title": "API 超时（毫秒）",
      "minimum": 1000,
      "maximum": 25000
    },
    "maxDurationSeconds": {
      "type": "integer",
      "title": "最长语音（秒）",
      "minimum": 1,
      "maximum": 60
    },
    "maxTranscriptChars": {
      "type": "integer",
      "title": "转写文本长度上限",
      "minimum": 100,
      "maximum": 4000
    },
    "cacheResults": {
      "type": "boolean",
      "title": "缓存本进程内已识别的消息，避免重复上传"
    },
    "modelsEndpoint": {
      "type": "string",
      "title": "模型列表 API 地址（可留空）",
      "description": "留空时读取同一基础地址下的 /models，保留网关前缀和查询参数。读取失败仍可手填模型；特殊接口可填完整 GET 地址。",
      "maxLength": 2048
    },
    "modelsResponsePath": {
      "type": "string",
      "title": "模型列表 JSON 路径",
      "description": "通常为 data；也支持 models 或 data.models。",
      "maxLength": 300
    },
    "autoReadModels": {
      "type": "boolean",
      "title": "配置页自动读取模型列表（不自动测试语音）"
    }
  }
}
