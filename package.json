    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "privacy:check": "node scripts/public-source-check.mjs",
    "test:shutdown": "node --test scripts/test-desktop-shutdown.mjs scripts/test-desktop-lifecycle.mjs",
    "test:hook-startup": "node --test scripts/test-hook-startup.mjs scripts/test-hook-launcher.mjs scripts/test-hook-repair-ui.mjs scripts/test-hook-repair-api.mjs scripts/test-process-recovery.mjs",
    "test:storage": "node --test scripts/test-installer-directory.mjs scripts/test-data-storage.mjs scripts/test-storage-runtime.mjs",
