    "test:plugin-contract": "node --test scripts/test-plugin-contract.mjs scripts/test-source-plugin-zip.mjs",
    "plugin:check": "node scripts/plugin-host-check.mjs",
    "plugin:pack": "node scripts/pack-bundled-plugins.mjs",
    "source:check": "node scripts/public-source-check.mjs",
    "source:build": "node scripts/build-source-release.mjs",
    "release:verify": "node scripts/verify-plugin-release.mjs",
    "test:speech-diagnostics": "node --test scripts/test-speech-diagnostics.mjs",
    "test:voice-codec": "node --test scripts/test-voice-codec.mjs",
    "test:speech-protocol": "node --test scripts/test-speech-protocol.mjs",
