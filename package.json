{
  "name": "wechatagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal WeChat AI friend with NT reader, WeChat-Hook, OneBot v11 and an existing DSH Desktop",
  "license": "SEE LICENSES.md",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 start",
    "stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 stop",
    "restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 restart",
    "status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/manage.ps1 status",
    "friend-ids": "node scripts/list-friend-ids.mjs",
    "sessions:configure": "node scripts/manage-dsh-sessions.mjs configure",
    "sessions:compact": "node scripts/manage-dsh-sessions.mjs compact",
    "sessions:status": "node scripts/manage-dsh-sessions.mjs status",
    "hook:build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-hook.ps1",
    "hook:test-native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-native-hook.ps1",
    "hook:open": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/launch-hook-wechat.ps1",
    "hook:pin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/pin-hook-client.ps1",
    "hook:unpin": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/pin-hook-client.ps1 -Unlock",
    "hook:check": "node scripts/hook-onebot.mjs --check",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "test": "node scripts/test-project.mjs && node --test scripts/test-image-input.mjs scripts/test-native-session.mjs scripts/test-io-migration.mjs scripts/test-hook-onebot.mjs scripts/test-sync.cjs scripts/test-reader.mjs scripts/test-dsh-plugin.mjs components/qq-bridge/scripts/test-social-bridge.mjs components/qq-bridge/scripts/test-social-e2e.mjs"
  }
}
